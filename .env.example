# ---------------------------------------------------------------------------
# TravelDiary — environment configuration
# Copy this file to .env (local dev) and fill in real values.
# Never commit .env or any file containing real secrets.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
# Local dev matches docker-compose.yml. Use a pooled connection string in prod.
DATABASE_URL="postgresql://traveldiary:traveldiary@localhost:5432/traveldiary?schema=public"

# --- Auth.js (NextAuth v5) ---------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# Base URL of the app, used to build callback URLs.
AUTH_URL="http://localhost:3000"

# Google OAuth provider (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Passwordless email (magic link) provider — any SMTP-compatible sender.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="TravelDiary <no-reply@traveldiary.app>"

# --- Media / object storage --------------------------------------------------
# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, ...).
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_REGION=""
MEDIA_STORAGE_BUCKET=""
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
# Public CDN base URL that serves the bucket contents.
MEDIA_CDN_BASE_URL=""

# --- Map provider -------------------------------------------------------------
# Vector basemap tiles (e.g. MapTiler, Mapbox, Stadia Maps).
MAP_PROVIDER_KEY=""

# --- Analytics -----------------------------------------------------------------
# Optional. Leave blank to fall back to the no-op console adapter in dev.
ANALYTICS_PROVIDER="console"
ANALYTICS_KEY=""

# --- App -------------------------------------------------------------------
NODE_ENV="development"
